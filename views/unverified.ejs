<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Confirm your email - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card tn-card-wide tn-status">
            <div class="tn-status-icon is-warn" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </div>
            <h1>Confirm your email</h1>
            <p class="tn-sub">We sent a link to <strong><%= email %></strong>. Open it to finish setting up your account.</p>
            <div class="tn-alert">
                <div><strong>No email?</strong> Check spam and "Other" or "Promotions" tabs, and give it a few minutes. UMD mail can be slow.</div>
            </div>
            <div class="tn-actions">
                <form action="/resend-verification" method="POST">
                    <input type="hidden" name="email" value="<%= email %>" />
                    <button type="submit" class="tn-btn tn-btn-primary">Resend the email</button>
                </form>
                <a href="/contact" class="tn-btn tn-btn-outline">Get help</a>
            </div>
            <p class="tn-alt"><a href="/register">Sign up with a different email</a> · <a href="/login">Log in</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
