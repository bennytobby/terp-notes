<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Reset your password - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card">
            <h1>Reset your password</h1>
            <p class="tn-sub">Enter the UMD email you signed up with. If it has an account, we'll send a reset link.</p>
            <form action="/forgot-password" method="POST" class="tn-form">
                <label class="tn-label" for="email">UMD email
                    <input class="tn-input" type="email" id="email" name="email" required autofocus autocomplete="email" autocapitalize="none" spellcheck="false" inputmode="email" placeholder="testudo@terpmail.umd.edu" />
                </label>
                <button type="submit" class="tn-btn tn-btn-primary tn-btn-lg tn-btn-block">Send reset link</button>
            </form>
            <p class="tn-alt">Remembered it? <a href="/login">Log in</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
