                // Initialize edit modal with new multi-cache system
                function initializeEditModalWithCache() {
                    const editClassCodeInput = document.getElementById('editClassCode');
                    const editProfessorInput = document.getElementById('editProfessor');

                    if (!editClassCodeInput || !editProfessorInput) return;

                    // Check if event listeners are already attached to prevent duplicates
                    if (editClassCodeInput.hasAttribute('data-edit-listeners-attached')) return;
                    if (editProfessorInput.hasAttribute('data-edit-listeners-attached')) return;

                    // Add input event listeners for filtering
                    editClassCodeInput.addEventListener('input', function() {
                        const searchTerm = this.value;
                        editSelectedCourse = searchTerm;
                        filterEditCourses(searchTerm);

                        // Filter professors for the selected course
                        if (searchTerm && courseCache && courseCache.courses[searchTerm]) {
                            filterEditProfessorsForCourse(searchTerm);
                        }
                    });

                    editClassCodeInput.addEventListener('focus', function() {
                        if (this.value.length >= 2) {
                            filterEditCourses(this.value);

                            // Filter professors for the selected course
                            if (this.value && courseCache && courseCache.courses[this.value]) {
                                filterEditProfessorsForCourse(this.value);
                            }
                        }
                    });

                    editProfessorInput.addEventListener('input', function() {
                        const searchTerm = this.value.trim();
                        editSelectedProfessor = searchTerm;

                        // Show dropdown
                        const editProfessorsDropdown = document.getElementById('editProfessorsDropdown');
                        if (editProfessorsDropdown) {
                            editProfessorsDropdown.classList.add('show');
                        }

                        // Filter professors using optimized cache - just like upload section
                        filterEditProfessors(searchTerm);
                    });

                    editProfessorInput.addEventListener('focus', function() {
                        // If a course is selected, filter professors for that course, otherwise show all professors
                        if (editSelectedCourse && courseCache && courseCache.courses[editSelectedCourse]) {
                            filterEditProfessorsForCourse(editSelectedCourse);
                        } else if (this.value.length >= 2) {
                            // Show dropdown and filter - just like upload section
                            const editProfessorsDropdown = document.getElementById('editProfessorsDropdown');
                            if (editProfessorsDropdown) {
                                editProfessorsDropdown.classList.add('show');
                            }
                            filterEditProfessors(this.value);
                        }
                    });

                    // Mark elements as having listeners attached
                    editClassCodeInput.setAttribute('data-edit-listeners-attached', 'true');
                    editProfessorInput.setAttribute('data-edit-listeners-attached', 'true');

                    // Add semester and year change event listeners with selection preservation
                    const editSemesterSelect = document.getElementById('editSemester');
                    const editYearSelect = document.getElementById('editYear');

                    if (editSemesterSelect && !editSemesterSelect.hasAttribute('data-edit-listeners-attached')) {
                        editSemesterSelect.addEventListener('change', function() {
                            const semesterValue = this.value;
                            editSelectedSemester = semesterValue;
                            console.log('Edit semester changed to:', semesterValue);

                            // Filter year dropdown based on selected semester and course/professor
                            if (semesterValue && (editSelectedCourse || editSelectedProfessor)) {
                                filterEditYearsForSemester(semesterValue);
                            }
                        });
                        editSemesterSelect.setAttribute('data-edit-listeners-attached', 'true');
                    }

                    if (editYearSelect && !editYearSelect.hasAttribute('data-edit-listeners-attached')) {
                        editYearSelect.addEventListener('change', function() {
                            const yearValue = this.value;
                            editSelectedYear = yearValue;
                            console.log('Edit year changed to:', yearValue);

                            // Filter semester dropdown based on selected year and course/professor
                            if (yearValue && (editSelectedCourse || editSelectedProfessor)) {
                                filterEditSemestersForYear(yearValue);
                            }
                        });
                        editYearSelect.setAttribute('data-edit-listeners-attached', 'true');
                    }
                }

                // Edit file functionality
                function openEditModal(fileData) {
                    const modal = document.getElementById('editFileModal');
                    const form = document.getElementById('editFileForm');

                    // Populate form with current file data
                    document.getElementById('editFileId').value = fileData.filename;
                    document.getElementById('editClassCode').value = fileData.classCode || '';
                    document.getElementById('editProfessor').value = fileData.professor || '';
                    document.getElementById('editSemester').value = fileData.semester || '';
                    document.getElementById('editYear').value = fileData.year || '';

                    // Set category selection - ensure exact match
                    const categorySelect = document.getElementById('editCategory');
                    const currentCategory = fileData.category || '';

                    // Try to find exact match first
                    for (let option of categorySelect.options) {
                        if (option.value === currentCategory) {
                            option.selected = true;
                            break;
                        }
                    }

                    // If no exact match found, try to find by display text
                    if (categorySelect.value !== currentCategory) {
                        for (let option of categorySelect.options) {
                            if (option.text.includes(currentCategory) || currentCategory.includes(option.text)) {
                                option.selected = true;
                                break;
                            }
                        }
                    }

                    document.getElementById('editDescription').value = fileData.description || '';

                    // Initialize edit modal with new multi-cache system
                    initializeEditModalWithCache();

                    // Set up edit modal selections for filtering
                    editSelectedCourse = fileData.classCode || '';
                    editSelectedProfessor = fileData.professor || '';
                    editSelectedSemester = fileData.semester || '';
                    editSelectedYear = fileData.year || '';

                    // Show modal
                    modal.style.display = 'block';

                    // Initialize filtering based on existing data
                    setTimeout(() => {
                        if (editSelectedCourse && courseCache && courseCache.courses[editSelectedCourse]) {
                            // Filter professors for the existing course
                            filterEditProfessorsForCourse(editSelectedCourse);
                        }

                        // Show success message if we have existing data
                        if (editSelectedCourse && courseCache && courseCache.courses[editSelectedCourse]) {
                            const courseProfessors = Object.keys(courseCache.courses[editSelectedCourse].professors);
                            showEditSuccessMessage('professors', courseProfessors.length, editSelectedCourse);
                        }
                    }, 100);

                }

