                    const background = config.background || '#FEF3C7';
                    const color = config.color || '#D97706';
                    const icon = config.icon || '/images/icons/security-shield-check.png';
                    const text = config.text || 'Scanned';

                    let tooltipMessage = 'No virus detected';

                    // Add scan date if available
