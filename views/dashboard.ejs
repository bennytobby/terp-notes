                function updateEditSemesterYearForProfessor(professorName) {
                    if (!professorCache || !professorCache.professors[professorName]) return;

                    const currentYear = new Date().getFullYear();
                    const allSemesters = new Set();
                    const allYears = new Set();

                    // Collect all semesters and years for this professor
                    Object.values(professorCache.professors[professorName]).forEach(semesters => {
                        semesters.forEach(semesterData => {
                            if (semesterData.year <= currentYear) {
                                allSemesters.add(semesterData.semester);
                                allYears.add(semesterData.year);
                            }
                        });
                    });

                    // Update semester dropdown
                    const semesterSelect = document.getElementById('editSemester');
                    if (semesterSelect) {
                        semesterSelect.innerHTML = '<option value="">Select semester</option>';
                        Array.from(allSemesters).sort().forEach(semester => {
                            const option = document.createElement('option');
                            option.value = semester;
                            option.textContent = semester;
                            semesterSelect.appendChild(option);
                        });
