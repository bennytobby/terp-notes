                    } else if (status === 'pending') {
                        return '<span class="scan-badge scan-pending">⏳ Scanning...</span>';
                    } else if (status === 'error') {
                        return getScanErrorBadge(file);
                    }
                    return '';
                }

                // Generate scan error badge with tooltip showing specific error
                function getScanErrorBadge(file) {
                    let errorMessage = 'Scan failed';
                    let errorType = 'error';

                    if (file && file.virusScanDetails && file.virusScanDetails.error) {
                        const error = file.virusScanDetails.error;

                        // Parse common error types for user-friendly messages
                        if (error.includes('413') || error.includes('FileTooBig')) {
                            errorMessage = 'File too large for scanning';
                            errorType = 'size';
                        } else if (error.includes('400') || error.includes('Bad request')) {
                            errorMessage = 'Invalid file format';
                            errorType = 'format';
                        } else if (error.includes('422') || error.includes('Unprocessable')) {
                            errorMessage = 'File cannot be processed';
                            errorType = 'process';
                        } else if (error.includes('QuotaExceeded')) {
                            errorMessage = 'Scan quota exceeded';
                            errorType = 'quota';
                        } else if (error.includes('timeout')) {
                            errorMessage = 'Scan timed out';
                            errorType = 'timeout';
                        } else if (error.includes('permanent_error')) {
                            errorMessage = 'Cannot be scanned (permanent error)';
                            errorType = 'permanent';
                        } else if (error.includes('max_attempts_reached')) {
                            errorMessage = 'Scan failed after multiple attempts';
                            errorType = 'attempts';
                        } else {
                            // Use the actual error message if it's user-friendly
                            errorMessage = error.length > 50 ? error.substring(0, 50) + '...' : error;
                        }
                    }

                    // Use config-based styling for consistency
                    const config = dashboardConfig?.statusBadges?.error || {};
                    const background = config.background || '#FEF2F2';
                    const color = config.color || '#DC2626';
                    const icon = config.icon || '/images/icons/warning-triangle.png';
                    const text = config.text || 'Scan Error';

                    return `<span class="scan-badge scan-error" title="Scan Error: ${escapeHtml(errorMessage)}" data-error-type="${errorType}" style="background: ${background}; color: ${color}; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; cursor: help;"><img src="${icon}" alt="Scan Error" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 4px;" onerror="this.style.display='none';" /> ${text}</span>`;
                }

