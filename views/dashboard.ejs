                    const categoryName = fullText.replace(/^[▶▼]\s*/, '').replace(/[📚✏️📖📝📊📋💻🔬📄]\s*/, '').replace(/\s+\d+\s+files?.*$/i, '').replace(/\s+/g, ' ').trim();


