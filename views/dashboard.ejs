                            // Add years from cache if available
                            if (semesterYearCache && semesterYearCache.years) {
                                semesterYearCache.years.forEach(year => years.add(year));
                            }

                            // Add reasonable range (current year + 1 to current year - 10)
                            for (let year = currentYear + 1; year >= currentYear - 10; year--) {
                                years.add(year);
                            }

                            // Sort years in descending order and add to dropdown
                            Array.from(years).sort((a, b) => b - a).forEach(year => {
