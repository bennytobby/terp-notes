                // Highlight matching text
                function highlightText(text, searchTerm) {
                    if (!searchTerm) return text;
                    const regex = new RegExp(`(${searchTerm})`, 'gi');
                    return text.replace(regex, '<span class="highlight">$1</span>');
                }

                // Show success message for edit modal
                function showEditSuccessMessage(type, count, courseId = '') {
                    if (type === 'professors') {
                        const professorHelp = document.querySelector('#editFileModal .form-group:has(#editProfessor) .help-text, #editFileModal .form-group:has(#editProfessor) .semester-year-info');
                        if (professorHelp) {
                            professorHelp.textContent = `${count} professor${count !== 1 ? 's' : ''} taught ${courseId}`;
                            professorHelp.style.color = '#10B981';
                        } else {
                            // Create the help text element if it doesn't exist
                            const professorField = document.getElementById('editProfessor').closest('.form-group');
                            if (professorField) {
                                const helpDiv = document.createElement('div');
                                helpDiv.className = 'help-text';
                                helpDiv.style.cssText = 'font-size: 0.875rem; color: #10B981; margin-top: 4px;';
                                helpDiv.textContent = `${count} professor${count !== 1 ? 's' : ''} taught ${courseId}`;
                                professorField.appendChild(helpDiv);
                            }
                        }
                    }
                }

                // Edit modal filtering functions
                function filterEditCourses(searchTerm = '') {
                    if (!courseCache) return;

                    let courses;

                    // If a professor is selected in edit modal, only show their courses
                    if (editSelectedProfessor && professorCache && professorCache.professors[editSelectedProfessor]) {
                        courses = Object.keys(professorCache.professors[editSelectedProfessor]);
                    } else {
                        // Show all courses
                        courses = Object.keys(courseCache.courses);
                    }

                    const filtered = courses.filter(courseId => {
                        const courseInfo = courseCache.courses[courseId].courseInfo;
                        let courseName = courseInfo.name;

                        // Remove redundant "Course" prefix for filtering
                        if (courseName.startsWith('Course ')) {
                            courseName = courseName.substring(7);
                        }

                        return courseId.toLowerCase().includes(searchTerm.toLowerCase()) ||
                               courseName.toLowerCase().includes(searchTerm.toLowerCase());
                    });

                    renderEditCoursesDropdown(filtered.map(courseId => ({
                        course_id: courseId,
                        name: courseCache.courses[courseId].courseInfo.name
                    })), searchTerm);
                }

                function renderEditCoursesDropdown(courses, searchTerm) {
                    const courseInfo = document.getElementById('editClassCodeSuggestions');
                    if (!courseInfo) return;

                    if (courses.length === 0) {
                        courseInfo.innerHTML = '';
                        return;
                    }

                    // Sort courses alphabetically
                    const sortedCourses = [...courses].sort((a, b) => a.course_id.localeCompare(b.course_id));

                    courseInfo.innerHTML = sortedCourses.map(course => {
                        const courseId = course.course_id;
                        let courseName = course.name || courseId;

                        // Remove redundant "Course" prefix if it exists
                        if (courseName.startsWith('Course ')) {
                            courseName = courseName.substring(7); // Remove "Course " prefix
                        }

                        return `<option value="${courseId}" data-course-name="${courseName}">${courseId} - ${courseName}</option>`;
                        }).join('');
                }

                function filterEditProfessors(searchTerm = '') {
                    if (!professorCache) return;

                    const professors = Object.keys(professorCache.professors);
                    const filtered = professors.filter(profName =>
                        profName.toLowerCase().includes(searchTerm.toLowerCase())
                    );

                    renderEditProfessorsDropdown(filtered.map(profName => {
                        const profData = professorCache.professors[profName];
                        const allSemesters = [];

                        // Collect all semesters for this professor
                        Object.values(profData).forEach(semesters => {
                            semesters.forEach(semesterData => {
                                allSemesters.push(semesterData);
                            });
                        });

                        return {
                            name: profName,
                            courses: Object.keys(profData),
                            semesters: allSemesters
                        };
                    }), searchTerm);
                }

                function filterEditProfessorsForCourse(courseId) {
                    if (!courseCache || !courseCache.courses[courseId]) return;

                    const courseProfessors = Object.keys(courseCache.courses[courseId].professors);

                    // Show success message
                    showEditSuccessMessage('professors', courseProfessors.length, courseId);

                    const professorData = courseProfessors.map(profName => {
                        const profData = professorCache.professors[profName] || {};
                        const allSemesters = [];

                        // Collect all semesters for this professor
                        Object.values(profData).forEach(semesters => {
                            semesters.forEach(semesterData => {
                                allSemesters.push(semesterData);
                            });
                        });

                        return {
                            name: profName,
                            courses: Object.keys(profData),
                            semesters: allSemesters
                        };
                    });

                    renderEditProfessorsDropdown(professorData, '');
                }

                function renderEditProfessorsDropdown(professors, searchTerm) {
                    const editProfessorsDropdown = document.getElementById('editProfessorsDropdown');
                    if (!editProfessorsDropdown) return;

                    if (professors.length === 0) {
                        editProfessorsDropdown.innerHTML = '<div class="custom-dropdown-empty">No professors found</div>';
                        editProfessorsDropdown.classList.add('show');
                        return;
                    }

                    // Sort professors alphabetically
                    const sortedProfessors = [...professors].sort((a, b) => a.name.localeCompare(b.name));

                    editProfessorsDropdown.innerHTML = sortedProfessors.map((prof, index) => {
                        const professorName = prof.name;
                        const highlightedName = highlightText(professorName, searchTerm);

                        // Create semester tags
                        let semesterTags = '';
                        if (prof.semesters && prof.semesters.length > 0) {
                            const uniqueSemesters = [...new Set(prof.semesters.map(s => `${s.semester} ${s.year}`))];
                            semesterTags = uniqueSemesters.map(sem =>
                                `<span class="semester-tag" style="display: inline-block; background: #FEE2E2; color: #DC2626; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; margin: 1px 2px 1px 0; font-weight: 500;">${sem}</span>`
                            ).join('');
                        }

                        return `
                            <div class="custom-dropdown-item" data-professor-name="${professorName}" style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #F3F4F6;">
                                <div style="font-weight: 600; color: #1F2937;">${highlightedName}</div>
                                ${semesterTags ? `<div class="semester-tags" style="margin-top: 4px;">${semesterTags}</div>` : ''}
                            </div>
