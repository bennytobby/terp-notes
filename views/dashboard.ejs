                            editProfessorsDropdown.classList.remove('show');

                            // Set edit professor selection
                            editSelectedProfessor = professorName;

                            // Don't clear edit course field - preserve existing selection
                            // Filter courses for this professor
                            filterEditCourses('');

                            // Update semester/year dropdowns
                            updateEditSemesterYearForProfessor(professorName);
                        });
                    });

                    // Add click-outside-to-close functionality
                    setTimeout(() => {
                        document.addEventListener('click', function(event) {
                            const editProfessorInput = document.getElementById('editProfessor');
                            if (!editProfessorsDropdown.contains(event.target) && !editProfessorInput.contains(event.target)) {
                                editProfessorsDropdown.classList.remove('show');
                                document.removeEventListener('click', arguments.callee);
                            }
