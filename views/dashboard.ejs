                        // Update available options based on search results
                        function updateAvailableOptions(results) {
                            // Set flag to prevent infinite loops
                            isUpdatingDropdowns = true;

                            // Store current values to preserve user selections
                            const currentSemester = document.getElementById('semester').value;
                            const currentYearValue = document.getElementById('year').value;

                            // Update semester dropdown
                            const semesterSelect = document.getElementById('semester');
                            semesterSelect.innerHTML = '<option value="">Select semester</option>';

                            if (results.semesters && results.semesters.length > 0) {
                                results.semesters.forEach(semester => {
                                    const option = document.createElement('option');
                                    option.value = semester;
                                    option.textContent = semester;
                                    semesterSelect.appendChild(option);
                                });
                            } else {
                                // Show all semesters if no specific results
                                ['Spring', 'Summer', 'Fall', 'Winter'].forEach(semester => {
                                    const option = document.createElement('option');
                                    option.value = semester;
                                    option.textContent = semester;
                                    semesterSelect.appendChild(option);
                                });
                            }

                            // Update year dropdown
                            const yearSelect = document.getElementById('year');
                            yearSelect.innerHTML = '<option value="">Select year</option>';

                            const currentYear = new Date().getFullYear();

                            if (results.years && results.years.length > 0) {
                                // Filter out future years and sort in descending order
                                const validYears = results.years
                                    .filter(year => year <= currentYear)
                                    .sort((a, b) => b - a);

                                validYears.forEach(year => {
                                    const option = document.createElement('option');
                                    option.value = year;
                                    option.textContent = year;
                                    yearSelect.appendChild(option);
                                });
                            } else {
                                // Show recent years if no specific results
                                for (let y = currentYear; y >= currentYear - 4; y--) {
                                    const option = document.createElement('option');
                                    option.value = y;
                                    option.textContent = y;
                                    yearSelect.appendChild(option);
                                }
                            }

                            // Restore user selections if they're still valid
                            if (currentSemester && semesterSelect.querySelector(`option[value="${currentSemester}"]`)) {
                                semesterSelect.value = currentSemester;
                            }
                            if (currentYearValue && yearSelect.querySelector(`option[value="${currentYearValue}"]`)) {
                                yearSelect.value = currentYearValue;
                            }

                            // Clear flag after a short delay
                            setTimeout(() => {
                                isUpdatingDropdowns = false;
                                    }, 100);

                            // Update professor dropdown if we have professor results
                            if (results.professors && results.professors.length > 0) {
                                professorData = results.professors;
                                renderProfessorsDropdown(results.professors, professorInput.value);

                                // Show professor dropdown if it's not already visible
                                if (professorInput.value.trim() === '') {
                                    professorsDropdown.classList.add('show');
                                }
                            }

                            // Update course dropdown if we have course results
                            if (results.courses && results.courses.length > 0) {
                                // Update the course dropdown with available courses
                                allCourses = results.courses;
                                updateCourseDropdown(results.courses);

                                // Show course dropdown if it's not already visible
                                if (classCodeInput.value.trim() === '') {
                                    renderCoursesDropdown(results.courses, '');
                                    coursesDropdown.classList.add('show');
                                }
                            } else if (results.courses && results.courses.length === 0) {
                                // No courses available - clear the dropdown
                                allCourses = [];
                                updateCourseDropdown([]);
                                coursesDropdown.classList.remove('show');
                            }
                        }

