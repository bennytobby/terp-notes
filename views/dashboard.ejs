                function canDeleteFile(file) {
                    const userRole = '<%= user.role %>';
                    const userId = '<%= user.userid %>';
                    return userRole === 'admin' || file.uploadedBy === userId;
                }

                // Check if user has any delete permissions at all
                function userHasDeletePermissions() {
                    const userRole = '<%= user.role %>';
                    return userRole !== 'viewer';
                }

                // Duplicate function removed - using the one defined earlier that uses dashboardConfig

                function getDeleteButton(file) {
                    const userRole = '<%= user.role %>';
                    const userId = '<%= user.userid %>';

                    // Only show delete button if user can actually delete the file
                    if (userRole === 'admin' || file.uploadedBy === userId) {
                        return `<button class="button danger" onclick="confirmDelete('${encodeURIComponent(file.filename)}', '${escapeHtml(file.originalName)}')" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">Delete</button>`;
