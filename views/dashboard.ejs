                // showViewerAlert function removed - buttons are now hidden instead of disabled

                // Global variables for multiple cache data
                let professorCache = null;
                let courseCache = null;
                let semesterYearCache = null;

                // Track current selections for filtering
                let selectedProfessor = null;
                let selectedCourse = null;
                let selectedSemester = null;
