                    }
                    // If only course is selected in edit modal, filter by course's professors
                    else if (editSelectedCourse && courseCache && courseCache.courses[editSelectedCourse]) {
                        Object.values(courseCache.courses[editSelectedCourse].professors).forEach(semesters => {
