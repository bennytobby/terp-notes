                        // Course filtering using course cache
                        function filterCourses(searchTerm = '') {
                            if (!courseCache) return;

                            let courses;

                            // If a professor is selected, only show their courses
                            if (selectedProfessor && professorCache && professorCache.professors[selectedProfessor]) {
                                courses = Object.keys(professorCache.professors[selectedProfessor]);
                                console.log('🎯 Filtering courses for selected professor:', selectedProfessor, 'Courses:', courses);
                            } else {
                                // Show all courses
                                courses = Object.keys(courseCache.courses);
                            }

                            const filtered = courses.filter(courseId => {
                                const courseInfo = courseCache.courses[courseId].courseInfo;
                                let courseName = courseInfo.name;

                                // Remove redundant "Course" prefix for filtering
                                if (courseName.startsWith('Course ')) {
                                    courseName = courseName.substring(7);
                                }

                                return courseId.toLowerCase().includes(searchTerm.toLowerCase()) ||
                                       courseName.toLowerCase().includes(searchTerm.toLowerCase());
                            });

                            renderCoursesDropdown(filtered.map(courseId => ({
                                course_id: courseId,
                                name: courseCache.courses[courseId].courseInfo.name
                            })), searchTerm);
                        }

