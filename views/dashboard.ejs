<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Notes - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/topnav', { active: 'dashboard' }) %>

    <%
        // Only what the page needs. Escaping "<" keeps a file name like "</script>" from ending this tag.
        const canUpload = user.role !== 'viewer';
        const clientFiles = files.map(f => ({
            filename: f.filename,
            name: f.originalName,
            classCode: f.classCode || '',
            professor: f.professor || '',
            semester: f.semester || '',
            year: f.year ? String(f.year) : '',
            category: f.category || 'Other',
            description: f.description || '',
            uploadedBy: f.uploadedBy || '',
            uploadDate: f.uploadDate,
            size: f.size || 0,
            downloads: f.downloadCount || 0,
            mimetype: f.mimetype || '',
            held: Boolean(f.quarantined),
            scanning: /pending|scanning/i.test(String(f.virusScanStatus || '')),
            missing: Boolean(f.s3Missing),
            staffRole: (staffBadges || {})[`${f.classCode}|${f.uploadedBy}`] || ''
        }));
        const pageData = {
            files: clientFiles,
            user: { userid: user.userid, role: user.role },
            canUpload,
            hasCourseCatalog: typeof hasCourseCatalog === 'undefined' ? true : hasCourseCatalog,
            term: typeof currentTerm === 'undefined' ? null : currentTerm,
            allowedExtensions: typeof allowedExtensions === 'undefined' ? [] : allowedExtensions,
            pinnedCourses: (locals.shell && locals.shell.pinnedCourses) || []
        };
        const courseCount = new Set(clientFiles.map(f => f.classCode).filter(Boolean)).size;
    %>

    <main class="tn-page" id="main">
        <div class="tn-page-head">
            <div>
                <h1>Notes</h1>
                <p class="tn-sub"><%= clientFiles.length %> <%= clientFiles.length === 1 ? 'note' : 'notes' %> across <%= courseCount %> <%= courseCount === 1 ? 'course' : 'courses' %>, shared by UMD students.</p>
            </div>
            <% if (canUpload) { %>
                <button type="button" class="tn-btn tn-btn-primary" id="uploadOpen">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M6 10l6-6 6 6M4 20h16"/></svg>
                    Upload notes
                </button>
            <% } %>
        </div>

        <% (announcements || []).forEach(a => { %>
            <div class="tn-notice tn-notice-<%= ['warning', 'success', 'error'].includes(a.type) ? a.type : 'info' %>" role="status" data-announcement="<%= a._id %>">
                <p><% if (a.title) { %><strong><%= a.title %>.</strong> <% } %><%= a.message %></p>
                <button type="button" class="tn-icon-btn" data-dismiss aria-label="Dismiss">&times;</button>
            </div>
        <% }) %>

        <section class="tn-toolbar" aria-label="Search and filter notes">
            <div class="tn-search">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" id="q" placeholder="Search by file, course, professor or topic" aria-label="Search notes" autocomplete="off" enterkeyhint="search" />
            </div>
            <button type="button" class="tn-btn tn-btn-outline tn-filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filters">
                Filters<span class="tn-count" id="filterCount" hidden></span>
            </button>
            <div class="tn-filters" id="filters">
                <label class="tn-field"><span>Course</span>
                    <select id="fCourse"><option value="">All courses</option></select>
                </label>
                <label class="tn-field"><span>Type</span>
                    <select id="fCategory"><option value="">All types</option></select>
                </label>
                <label class="tn-field"><span>Term</span>
                    <select id="fTerm"><option value="">Any term</option></select>
                </label>
                <label class="tn-field"><span>Professor</span>
                    <select id="fProfessor"><option value="">Any professor</option></select>
                </label>
                <label class="tn-field"><span>Sort</span>
                    <select id="fSort">
                        <option value="newest">Newest</option>
                        <option value="popular">Most downloaded</option>
                        <option value="name">Name A–Z</option>
                    </select>
                </label>
                <label class="tn-switch">
                    <input type="checkbox" id="fMine" />
                    <span>My uploads</span>
                </label>
            </div>
        </section>

        <div class="tn-results-head">
            <p id="resultCount" aria-live="polite"></p>
            <div class="tn-results-actions">
                <button type="button" class="tn-link" id="pinCourse" aria-pressed="false" hidden></button>
                <button type="button" class="tn-link" id="clearFilters" hidden>Clear filters</button>
                <button type="button" class="tn-link" id="selectToggle">Select</button>
            </div>
        </div>

        <ul class="tn-files" id="fileList" aria-label="Notes"></ul>
        <div class="tn-empty" id="emptyState" hidden></div>
        <div class="tn-more"><button type="button" class="tn-btn tn-btn-outline" id="showMore" hidden>Show more</button></div>
    </main>

    <!-- Bulk actions while selecting -->
    <div class="tn-selectbar" id="selectBar" hidden>
        <span id="selectedCount">0 selected</span>
        <div>
            <button type="button" class="tn-btn tn-btn-outline" id="bulkCancel">Cancel</button>
            <button type="button" class="tn-btn tn-btn-outline tn-danger-text" id="bulkDelete" hidden>Delete</button>
            <button type="button" class="tn-btn tn-btn-outline" id="bulkBuddy" disabled>Study with Buddy</button>
            <button type="button" class="tn-btn tn-btn-primary" id="bulkDownload" disabled>Download .zip</button>
        </div>
    </div>

    <!-- Upload / edit (one form) -->
    <dialog class="tn-dialog" id="noteDialog" aria-labelledby="noteDialogTitle">
        <form method="dialog" id="noteForm" novalidate>
            <div class="tn-dialog-head">
                <h2 id="noteDialogTitle">Upload notes</h2>
                <button type="button" class="tn-icon-btn" data-close aria-label="Close">&times;</button>
            </div>
            <div class="tn-dialog-body">
                <div class="tn-drop" id="dropZone">
                    <input type="file" id="fileInput" multiple class="tn-visually-hidden" />
                    <label for="fileInput" class="tn-drop-label">
                        <strong>Choose files</strong> or drag them here
                        <span>PDF, Word, slides, images, code or .zip, up to 100 MB each</span>
                    </label>
                    <ul class="tn-picked" id="pickedFiles"></ul>
                </div>
                <p class="tn-editing" id="editingName" hidden></p>

                <div class="tn-grid-2">
                    <div class="tn-field">
                        <label for="classCode">Class code <span class="tn-req">*</span></label>
                        <div class="combo">
                            <input type="text" id="classCode" name="classCode" placeholder="e.g. CMSC330" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" role="combobox" aria-expanded="false" aria-controls="courseList" aria-autocomplete="list" required />
                            <ul class="combo-list" id="courseList" role="listbox" hidden></ul>
                        </div>
                        <small class="tn-help" id="courseInfo"></small>
                        <small class="tn-error" data-for="classCode"></small>
                    </div>
                    <div class="tn-field">
                        <label for="professor">Professor <span class="tn-req">*</span></label>
                        <div class="combo">
                            <input type="text" id="professor" name="professor" placeholder="Professor's name" autocomplete="off" maxlength="80" role="combobox" aria-expanded="false" aria-controls="professorList" aria-autocomplete="list" required />
                            <ul class="combo-list" id="professorList" role="listbox" hidden></ul>
                        </div>
                        <small class="tn-help" id="professorHelp"></small>
                        <small class="tn-error" data-for="professor"></small>
                    </div>
                </div>
                <div class="tn-grid-3">
                    <div class="tn-field">
                        <label for="semester">Semester <span class="tn-req">*</span></label>
                        <select id="semester" name="semester" required>
                            <option value="">Select</option>
                            <option>Fall</option><option>Spring</option><option>Summer</option><option>Winter</option><option>Unknown</option>
                        </select>
                        <small class="tn-error" data-for="semester"></small>
                    </div>
                    <div class="tn-field">
                        <label for="year">Year <span class="tn-req">*</span></label>
                        <select id="year" name="year" required><option value="">Select</option></select>
                        <small class="tn-error" data-for="year"></small>
                    </div>
                    <div class="tn-field">
                        <label for="category">Type <span class="tn-req">*</span></label>
                        <select id="category" name="category" required></select>
                        <small class="tn-error" data-for="category"></small>
                    </div>
                </div>
                <div class="tn-field">
                    <label for="description">Description <span class="tn-req">*</span></label>
                    <input type="text" id="description" name="description" maxlength="300" placeholder="e.g. Week 3 lecture notes, Midterm 1 review" required />
                    <small class="tn-error" data-for="description"></small>
                </div>
                <label class="tn-check" id="integrityRow">
                    <input type="checkbox" id="integrity" />
                    <span>These notes are my own work or properly cited, and sharing them doesn't break UMD's academic integrity rules. <span class="tn-req">*</span></span>
                </label>
                <small class="tn-error" data-for="integrity"></small>
                <p class="tn-help" id="uploadNote">Uploads are checked for viruses and personal information. Anything that looks like personal information waits for an admin before others can see it.</p>
                <div class="tn-progress" id="uploadProgress" hidden><div></div></div>
                <p class="tn-help" id="uploadStatus" role="status"></p>
            </div>
            <div class="tn-dialog-foot">
                <button type="button" class="tn-btn tn-btn-outline" data-close>Cancel</button>
                <button type="submit" class="tn-btn tn-btn-primary" id="noteSubmit" value="default">Upload</button>
            </div>
        </form>
    </dialog>

    <!-- Report -->
    <dialog class="tn-dialog tn-dialog-sm" id="reportDialog" aria-labelledby="reportTitle">
        <form method="dialog" id="reportForm">
            <div class="tn-dialog-head">
                <h2 id="reportTitle">Report this file</h2>
                <button type="button" class="tn-icon-btn" data-close aria-label="Close">&times;</button>
            </div>
            <div class="tn-dialog-body">
                <p class="tn-help" id="reportName"></p>
                <fieldset class="tn-radios">
                    <legend class="tn-visually-hidden">Reason</legend>
                    <% ['Inappropriate content', 'Copyright violation', 'Malicious file', 'Academic integrity violation (unauthorized exam or project)', 'Spam or irrelevant content', 'Other'].forEach((r, i) => { %>
                        <label class="tn-check"><input type="radio" name="reason" value="<%= r %>" <%= i === 0 ? 'checked' : '' %> /><span><%= r %></span></label>
                    <% }) %>
                </fieldset>
                <div class="tn-field">
                    <label for="reportDetails">Details (optional)</label>
                    <textarea id="reportDetails" rows="3" maxlength="500"></textarea>
                </div>
            </div>
            <div class="tn-dialog-foot">
                <button type="button" class="tn-btn tn-btn-outline" data-close>Cancel</button>
                <button type="submit" class="tn-btn tn-btn-primary" value="default">Send report</button>
            </div>
        </form>
    </dialog>

    <!-- Confirm -->
    <dialog class="tn-dialog tn-dialog-sm" id="confirmDialog" aria-labelledby="confirmTitle">
        <form method="dialog">
            <div class="tn-dialog-body">
                <h2 id="confirmTitle">Delete?</h2>
                <p class="tn-help" id="confirmText"></p>
            </div>
            <div class="tn-dialog-foot">
                <button type="submit" class="tn-btn tn-btn-outline" value="cancel">Cancel</button>
                <button type="submit" class="tn-btn tn-btn-danger" value="confirm" id="confirmOk">Delete</button>
            </div>
        </form>
    </dialog>

    <div class="tn-toasts" id="toasts" aria-live="polite"></div>

    <script type="application/json" id="pageData"><%- JSON.stringify(pageData).replace(/</g, '\\u003c') %></script>
    <script src="/javascripts/course-picker.js"></script>
    <script src="/javascripts/dashboard.js"></script>
    <%- include('partials/footer') %>
</body>
</html>
