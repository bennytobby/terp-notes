                // Dynamic helper functions using configuration

                // Get file icon based on filename extension
                function getFileIcon(filename) {
                    const ext = filename.split('.').pop().toLowerCase();

                    // Fallback icon mapping if config is not loaded
                    const fallbackIcons = {
                        pdf: '/images/icons/pdf-file.png',
                        doc: '/images/icons/word-file.png',
                        docx: '/images/icons/word-file.png',
                        xls: '/images/icons/excel-file.png',
                        xlsx: '/images/icons/excel-file.png',
                        ppt: '/images/icons/powerpoint-file.png',
                        pptx: '/images/icons/powerpoint-file.png',
                        txt: '/images/icons/text-file.png',
                        zip: '/images/icons/zip-file.png',
                        rar: '/images/icons/zip-file.png',
                        jpg: '/images/icons/image-file.png',
                        jpeg: '/images/icons/image-file.png',
                        png: '/images/icons/image-file.png',
                        gif: '/images/icons/image-file.png',
                        mp4: '/images/icons/video-file.png',
                        mov: '/images/icons/video-file.png',
                        mp3: '/images/icons/audio-file.png'
                    };

                    // Use PDF size as the default for all file types
                    const defaultSize = 80; // PDF default size

                    const config = dashboardConfig?.fileTypeIcons || {};
                    const defaultConfig = dashboardConfig?.defaultFileIcon || {
                        icon: '/images/icons/document.png',
                        alt: 'Document',
                        width: defaultSize,
                        height: defaultSize
                    };

                    const fileConfig = config[ext] || {
                        icon: fallbackIcons[ext] || defaultConfig.icon,
                        alt: ext.toUpperCase() || 'Document',
                        width: defaultSize, // Use PDF size for all
                        height: defaultSize  // Use PDF size for all
                    };

                    // Override with PDF size for consistency and add error handling
                    return `<img src="${fileConfig.icon}" alt="${fileConfig.alt}" style="width: ${defaultSize}px; height: ${defaultSize}px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" /><span style="display: none; background: #E5E7EB; color: #6B7280; padding: 0.5rem; border-radius: 4px; font-size: 0.75rem;">${fileConfig.alt}</span>`;
                }

                // Normalize category name by removing emojis and matching to config
                function normalizeCategoryName(category) {
                    if (!category) return 'Other';

                    // Remove emojis and trim whitespace
                    const cleanCategory = category.replace(/[📚✏️📖📝📊📋💻🔬📄🧪🗒️]/g, '').trim();

                    // Try exact match first
                    const config = dashboardConfig?.categories || {};
                    if (config[category]) return category;
                    if (config[cleanCategory]) return cleanCategory;

                    // Try fuzzy matching for common variations
                    const fuzzyMatches = {
                        'Lab Report': ['Lab Report', 'Lab', '🔬 Lab Report'],
                        'Lecture Notes': ['Lecture Notes', '📚 Lecture Notes'],
                        'Practice Problems': ['Practice Problems', '🔢 Practice Problems'],
                        'Study Guide': ['Study Guide', '📖 Study Guide'],
                        'Exam': ['Exam', '📝 Exam'],
                        'Homework': ['Homework', '✏️ Homework'],
                        'Project': ['Project', '💻 Project'],
                        'Textbook': ['Textbook', '📕 Textbook']
                    };

                    for (const [normalized, variations] of Object.entries(fuzzyMatches)) {
                        if (variations.includes(category) || variations.includes(cleanCategory)) {
                            return normalized;
                        }
                    }

                    return 'Other';
                }

                // Get category emoji/icon
                function getCategoryEmoji(category) {
                    const normalizedCategory = normalizeCategoryName(category);
                    const config = dashboardConfig?.categories || {};
                    const categoryConfig = config[normalizedCategory] || config['Other'] || { icon: '📎' };
                    return categoryConfig.icon || '📎';
                }

                // Get category display name
                function getCategoryDisplayName(category) {
                    const normalizedCategory = normalizeCategoryName(category);
                    const config = dashboardConfig?.categories || {};
                    const categoryConfig = config[normalizedCategory] || config['Other'] || { displayName: category };
                    return categoryConfig.displayName || normalizedCategory;
                }

                // Format file size dynamically
                function formatFileSize(sizeInBytes) {
                    const config = dashboardConfig?.fileSize || {
                        units: ['B', 'KB', 'MB', 'GB'],
                        decimalPlaces: 1,
                        threshold: 1024
                    };

                    let size = sizeInBytes;
                    let unitIndex = 0;

                    while (size >= config.threshold && unitIndex < config.units.length - 1) {
                        size /= config.threshold;
                        unitIndex++;
                    }

                    return `${size.toFixed(config.decimalPlaces)} ${config.units[unitIndex]}`;
                }

                // Generate file size tag with color coding and tooltip
                function getFileSizeTag(sizeInBytes) {
                    const sizeKB = sizeInBytes / 1024;
                    const sizeMB = sizeKB / 1024;

                    let sizeClass = '';
                    let tooltip = '';

                    if (sizeKB < 500) {
                        sizeClass = 'file-size-small';
                        tooltip = 'Small file - Quick to download';
                    } else if (sizeKB < 2048) {
                        sizeClass = 'file-size-medium';
                        tooltip = 'Medium file - Normal download time';
                    } else if (sizeMB < 20) {
                        sizeClass = 'file-size-large';
                        tooltip = 'Large file - May take longer to download';
                    } else {
                        sizeClass = 'file-size-huge';
                        tooltip = 'Very large file - Consider your connection speed';
                    }

                    return `<span class="file-size-tag ${sizeClass}" title="${tooltip}">${formatFileSize(sizeInBytes)}</span>`;
                }

                // Generate consistent color for user based on username
                function getUserColor(username) {
                    if (!username) return '#6B7280'; // Default gray for empty usernames

                    // Simple hash function to convert string to number
                    let hash = 0;
                    for (let i = 0; i < username.length; i++) {
                        const char = username.charCodeAt(i);
                        hash = ((hash << 5) - hash) + char;
                        hash = hash & hash; // Convert to 32-bit integer
                    }

                    // Use absolute value and modulo to get a positive number
                    hash = Math.abs(hash);

                    // Generate HSL color with consistent hue, subtle but distinct saturation and lightness
                    const hue = hash % 360; // 0-360 degrees for hue
                    const saturation = 25 + (hash % 35); // 25-59% saturation for more distinct but still subtle colors
                    const lightness = 75 + (hash % 20); // 75-94% lightness for light but distinguishable colors

                    return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
                }

                // Get user color class name for CSS
                function getUserColorClass(username) {
                    if (!username) return 'user-color-default';
                    return `user-color-${username.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
                }

                // Generate consistent color for major based on major name
                function getMajorColor(major) {
                    if (!major) return '#6B7280'; // Default gray for empty majors

                    // Simple hash function to convert string to number
                    let hash = 0;
                    for (let i = 0; i < major.length; i++) {
                        const char = major.charCodeAt(i);
                        hash = ((hash << 5) - hash) + char;
                        hash = hash & hash; // Convert to 32-bit integer
                    }

                    // Use absolute value and modulo to get a positive number
                    hash = Math.abs(hash);

                    // Generate HSL color with consistent hue, subtle but distinct saturation and lightness
                    const hue = hash % 360; // 0-360 degrees for hue
                    const saturation = 30 + (hash % 40); // 30-69% saturation for distinct but not overwhelming colors
                    const lightness = 70 + (hash % 20); // 70-89% lightness for light, readable colors

                    return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
                }

                // Generate consistent color for course code based on course code
                function getCourseColor(courseCode) {
                    if (!courseCode) return '#6B7280'; // Default gray for empty course codes

                    // Simple hash function to convert string to number
                    let hash = 0;
                    for (let i = 0; i < courseCode.length; i++) {
                        const char = courseCode.charCodeAt(i);
                        hash = ((hash << 5) - hash) + char;
                        hash = hash & hash; // Convert to 32-bit integer
                    }

                    // Use absolute value and modulo to get a positive number
                    hash = Math.abs(hash);

                    // Generate HSL color with consistent hue, subtle but distinct saturation and lightness
                    const hue = hash % 360; // 0-360 degrees for hue
                    const saturation = 35 + (hash % 35); // 35-69% saturation for distinct but not overwhelming colors
                    const lightness = 65 + (hash % 25); // 65-89% lightness for light, readable colors

                    return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
                }

                // Check if file is "new" based on configurable threshold
                function isFileNew(uploadDate) {
                    const config = dashboardConfig?.statusBadges?.new || { thresholdDays: 7 };
                    const uploadDateObj = new Date(uploadDate);
                    const now = new Date();
                    const daysAgo = Math.floor((now - uploadDateObj) / (1000 * 60 * 60 * 24));
                    return daysAgo <= config.thresholdDays;
                }

                // Generate dynamic age-based tag
                function getAgeTag(uploadDate) {
                    const uploadDateObj = new Date(uploadDate);
                    const now = new Date();
                    const daysAgo = Math.floor((now - uploadDateObj) / (1000 * 60 * 60 * 24));
                    const monthsAgo = Math.floor(daysAgo / 30);
                    const yearsAgo = Math.floor(daysAgo / 365);

                    // Format the upload date for tooltip
                    const uploadDateFormatted = uploadDateObj.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });

                    if (daysAgo <= 7) {
                        return {
                            text: daysAgo === 0 ? 'Today' : daysAgo === 1 ? '1 day ago' : `${daysAgo} days ago`,
                            style: 'background: #D1FAE5; color: #065F46;', // Green for recent
                            icon: 'new-badge.png',
                            tooltip: `Uploaded ${daysAgo === 0 ? 'today' : daysAgo === 1 ? '1 day ago' : `${daysAgo} days ago`} (${uploadDateFormatted})`
                        };
                    } else if (daysAgo <= 30) {
                        return {
                            text: daysAgo <= 14 ? `${daysAgo} days ago` : `${Math.floor(daysAgo / 7)} weeks ago`,
                            style: 'background: #FEF3C7; color: #92400E;', // Yellow for somewhat recent
                            icon: 'clock-warning.png',
                            tooltip: `Uploaded ${daysAgo} days ago (${uploadDateFormatted})`
                        };
                    } else if (yearsAgo < 2) {
                        return {
                            text: monthsAgo === 1 ? '1 month ago' : `${monthsAgo} months ago`,
                            style: 'background: #FEF3C7; color: #92400E;', // Yellow for older
                            icon: 'clock-warning.png',
                            tooltip: `Uploaded ${monthsAgo === 1 ? '1 month ago' : `${monthsAgo} months ago`} (${uploadDateFormatted})`
                        };
                    } else {
                        return {
                            text: 'Old',
                            style: 'background: #FEE2E2; color: #DC2626;', // Red for very old
                            icon: 'warning-triangle.png',
                            tooltip: `Uploaded ${yearsAgo} years ago (${uploadDateFormatted})`
                        };
                    }
                }

                // Get delete button based on user permissions
                function getDeleteButton(file) {
                    const userRole = '<%= user.role %>';
                    const userId = '<%= user.userid %>';

                    if (userRole === 'viewer') {
                        return '';
                    }

                    if (userRole !== 'admin' && file.uploadedBy !== userId) {
                        return '';
                    }

                    return `<button class="button danger small delete-btn" onclick="confirmDelete('${file.filename}', '${escapeHtml(file.originalName)}')">Delete</button>`;
                }

                // Get edit button based on user permissions
                function getEditButton(file) {
                    const userRole = '<%= user.role %>';
                    const userId = '<%= user.userid %>';

                    if (userRole === 'viewer') {
                        return '';
                    }

                    if (userRole !== 'admin' && file.uploadedBy !== userId) {
                        return '';
                    }

                    return `<button class="button info small edit-btn" data-filename="${file.filename}" data-file-data='${JSON.stringify(file)}'>Edit</button>`;
                }

                // Generate download button with missing file check
                function getDownloadButton(file) {
                    if (file.s3Missing) {
                        return `<button class="button download" disabled style="opacity: 0.5; cursor: not-allowed;" title="File is no longer available">🚫 Unavailable</button>`;
                    }
                    return `<button onclick="downloadFile('${encodeURIComponent(file.filename)}')" class="button download">Download</button>`;
                }

                // Generate status badges dynamically
                function generateStatusBadges(file) {
                    const badges = [];
                    const config = dashboardConfig?.statusBadges || {};

                    // Age-based tag (replaces New badge)
                    const ageTag = getAgeTag(file.uploadDate);
                    badges.push(`<span class="age-badge" title="${escapeHtml(ageTag.tooltip)}" style="${ageTag.style} padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; cursor: help;"><img src="/images/icons/${ageTag.icon}" alt="${ageTag.text}" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 4px;" onerror="this.style.display='none';" /> ${ageTag.text}</span>`);

                    // Missing file indicator
                    if (file.s3Missing) {
                        badges.push(`<span style="background: #EF4444; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 600;" title="File is no longer available on our servers">🚫 Unavailable</span>`);
                    }

                    // Handle virus scan status badges with proper logic
                    if (file.virusScanStatus) {
                        const status = file.virusScanStatus.toString().toLowerCase();

                        // Error badge - use getScanErrorBadge for tooltip support
                        if (config.error?.enabled && (status.includes('error') || status.includes('failed') || status.includes('virus'))) {
                            badges.push(getScanErrorBadge(file));
                        }
                        // Pending badge - use getScanningBadge for tooltip support
                        else if (config.pending?.enabled && (status.includes('pending') || status.includes('scanning'))) {
                            badges.push(getScanningBadge(file));
                        }
                        // Scanned badge - use getScannedBadge for tooltip support
                        else if (config.scanned?.enabled && (status.includes('clean') || status.includes('scanned') || status === 'true')) {
                            badges.push(getScannedBadge(file));
                        }
                    }

                    // Category badge
                    if (config.category?.enabled && file.category) {
                        const categoryConfig = config.category;
                        badges.push(`<span style="background: ${categoryConfig.background}; color: ${categoryConfig.color}; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 600;">${getCategoryEmoji(file.category)} ${escapeHtml(getCategoryDisplayName(file.category))}</span>`);
                    }

                    return badges.join('');
                }

                // Get filtered files for grouped view (only Professor and Search filters)
                function getFilteredFilesForGroupedView() {
                    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
                    const selectedProfessors = Array.from(document.querySelectorAll('#professorDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const myFilesOnly = document.getElementById('myFilesToggle').checked;

                    return allFilesData.filter(function(file) {
                        // Search term filter
                        if (searchTerm && !file.originalName.toLowerCase().includes(searchTerm) &&
                            !(file.description && file.description.toLowerCase().includes(searchTerm))) {
                            return false;
                        }

                        // My files filter
                        const currentUserId = '<%= user.userid %>';
                        if (myFilesOnly && file.uploadedBy !== currentUserId) {
                            return false;
                        }

                        // Professor filter
                        if (selectedProfessors.length > 0) {
                            if (!file.professor || !selectedProfessors.some(selectedProf =>
                                file.professor.toLowerCase() === selectedProf.toLowerCase()
                            )) {
                                return false;
                            }
                        }

                        return true;
                    });
                }

                // Get filtered files based on current filters (for Grid and List views)
                function getFilteredFiles() {
                    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
                    const selectedCategories = Array.from(document.querySelectorAll('#categoryDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const selectedSemesters = Array.from(document.querySelectorAll('#semesterDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const selectedYears = Array.from(document.querySelectorAll('#yearDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const selectedMajors = Array.from(document.querySelectorAll('#majorDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const selectedClasses = Array.from(document.querySelectorAll('#classDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const selectedProfessors = Array.from(document.querySelectorAll('#professorDropdown input[type="checkbox"]:checked')).map(cb => cb.value);
                    const myFilesOnly = document.getElementById('myFilesToggle').checked;

                    return allFilesData.filter(function(file) {
                        // Search term filter
                        if (searchTerm && !file.originalName.toLowerCase().includes(searchTerm) &&
                            !(file.description && file.description.toLowerCase().includes(searchTerm))) {
                            return false;
                        }

                        // My files filter
                        const currentUserId = '<%= user.userid %>';
                        if (myFilesOnly && file.uploadedBy !== currentUserId) {
                            return false;
                        }

                        // Category filter
                        if (selectedCategories.length > 0) {
                            const fileCategory = normalizeCategoryName(file.category || 'Other');
                            if (!selectedCategories.includes(fileCategory)) {
                                return false;
                            }
                        }

                        // Semester filter
                        if (selectedSemesters.length > 0 && !selectedSemesters.includes(file.semester)) {
                            return false;
                        }

                        // Year filter
                        if (selectedYears.length > 0 && !selectedYears.includes(file.year.toString())) {
                            return false;
                        }

                        // Major filter
                        if (selectedMajors.length > 0 && !selectedMajors.includes(file.major)) {
                            return false;
                        }

                        // Class filter
                        if (selectedClasses.length > 0 && !selectedClasses.includes(file.classCode)) {
                            return false;
                        }

                        // Professor filter
                        if (selectedProfessors.length > 0) {
                            if (!file.professor || !selectedProfessors.some(selectedProf =>
                                file.professor.toLowerCase() === selectedProf.toLowerCase()
                            )) {
                                return false;
                            }
                        }

                        return true;
                    });
                }

