                    // If only professor is selected in edit modal, filter by professor's courses
                    else if (editSelectedProfessor && professorCache && professorCache.professors[editSelectedProfessor]) {
                        Object.values(professorCache.professors[editSelectedProfessor]).forEach(semesters => {
                            semesters.forEach(semesterData => {
                                if (semesterData.semester === selectedSemester) {
                                    availableYears.add(semesterData.year);
                                }
                            });
