<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Sign up - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card tn-card-wide">
            <h1>Join Terp Notes</h1>
            <p class="tn-sub">Free for UMD students. You'll confirm your email once, then you're in.</p>

            <div id="notificationContainer" aria-live="polite">
                <% if (locals.error) { %><div class="tn-alert tn-alert-error" role="alert"><%= error %></div><% } %>
            </div>

            <form action="/registerSubmit" method="POST" class="tn-form" novalidate>
                <div class="tn-form-row">
                    <label class="tn-label" for="first_name">First name
                        <input class="tn-input" type="text" name="first_name" id="first_name" autocomplete="given-name" required maxlength="64" value="<%= locals.first_name || '' %>" />
                    </label>
                    <label class="tn-label" for="last_name">Last name
                        <input class="tn-input" type="text" name="last_name" id="last_name" autocomplete="family-name" required maxlength="64" value="<%= locals.last_name || '' %>" />
                    </label>
                </div>
                <label class="tn-label" for="email">UMD email
                    <input class="tn-input" type="email" name="email" id="email" placeholder="testudo@terpmail.umd.edu" autocomplete="email" autocapitalize="none" spellcheck="false" inputmode="email" required value="<%= locals.email || '' %>" aria-describedby="email-help" />
                    <span class="tn-help" id="email-help">@umd.edu or @terpmail.umd.edu. We'll send a confirmation link.</span>
                </label>
                <label class="tn-label" for="userid">Username
                    <input class="tn-input" type="text" name="userid" id="userid" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" value="<%= locals.userid || '' %>" aria-describedby="userid-help" />
                    <span class="tn-help" id="userid-help">Shown on your uploads. You can't change it later.</span>
                </label>
                <label class="tn-label" for="password">Password
                    <input class="tn-input" type="password" name="password" id="password" autocomplete="new-password" required aria-describedby="password-rules" />
                    <ul class="tn-rules" id="password-rules" aria-live="polite">
                        <li id="req-length">8+ characters</li>
                        <li id="req-uppercase">An uppercase letter</li>
                        <li id="req-lowercase">A lowercase letter</li>
                        <li id="req-number">A number</li>
                        <li id="req-special">A symbol (!@#$…)</li>
                    </ul>
                </label>
                <label class="tn-label" for="confirm_pass">Confirm password
                    <input class="tn-input" type="password" name="confirm_pass" id="confirm_pass" autocomplete="new-password" required />
                    <span class="tn-help" id="match-help" aria-live="polite"></span>
                </label>
                <label class="tn-check">
                    <input type="checkbox" id="agreeTerms" name="agreeTerms" value="yes" required />
                    <span>I agree to the <a href="/terms" target="_blank">Terms of Service</a> and <a href="/privacy" target="_blank">Privacy Policy</a>, and I'll only share material I'm allowed to share.</span>
                </label>
                <button type="submit" class="tn-btn tn-btn-primary tn-btn-lg tn-btn-block" id="submitBtn">Create account</button>
                <p class="tn-help" style="text-align: center; margin: 0;">Terp Notes is run by students and isn't affiliated with UMD.</p>
            </form>
            <p class="tn-alt">Already have an account? <a href="/login">Log in</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Keep this list in step with utils/passwordValidator.js.
        const rules = {
            length: (p) => p.length >= 8,
            uppercase: (p) => /[A-Z]/.test(p),
            lowercase: (p) => /[a-z]/.test(p),
            number: (p) => /[0-9]/.test(p),
            special: (p) => /[!@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(p),
        };
        const pass = document.getElementById('password');
        const confirmPass = document.getElementById('confirm_pass');
        const matchHelp = document.getElementById('match-help');

        function update() {
            let ok = true;
            for (const [name, test] of Object.entries(rules)) {
                const met = test(pass.value);
                document.getElementById('req-' + name).classList.toggle('is-met', met);
                ok = ok && met;
            }
            if (!confirmPass.value) matchHelp.textContent = '';
            else matchHelp.textContent = confirmPass.value === pass.value ? '✓ Passwords match' : "Passwords don't match yet";
            matchHelp.style.color = confirmPass.value && confirmPass.value === pass.value ? 'var(--tn-ok)' : '';
            return ok;
        }
        pass.addEventListener('input', update);
        confirmPass.addEventListener('input', update);

        function showProblems(list) {
            const box = document.getElementById('notificationContainer');
            box.innerHTML = '';
            const el = document.createElement('div');
            el.className = 'tn-alert tn-alert-error';
            el.setAttribute('role', 'alert');
            const ul = document.createElement('ul');
            for (const item of list) {
                const li = document.createElement('li');
                li.textContent = item;
                ul.appendChild(li);
            }
            el.append('Almost there:', ul);
            box.appendChild(el);
            box.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }

        document.querySelector('form').addEventListener('submit', function (e) {
            const v = (id) => document.getElementById(id).value.trim();
            const problems = [];
            const invalid = [];
            if (!v('first_name') || !v('last_name')) { problems.push('Add your first and last name.'); invalid.push('first_name', 'last_name'); }
            if (!/@(terpmail\.)?umd\.edu$/i.test(v('email'))) { problems.push('Use your @umd.edu or @terpmail.umd.edu email.'); invalid.push('email'); }
            if (!v('userid')) { problems.push('Pick a username.'); invalid.push('userid'); }
            if (!update()) { problems.push('Your password needs everything in the checklist.'); invalid.push('password'); }
            if (pass.value !== confirmPass.value) { problems.push("The two passwords don't match."); invalid.push('confirm_pass'); }
            if (!document.getElementById('agreeTerms').checked) problems.push('Agree to the Terms and Privacy Policy.');
            for (const id of ['first_name', 'last_name', 'email', 'userid', 'password', 'confirm_pass']) {
                document.getElementById(id).classList.toggle('is-invalid', invalid.includes(id));
            }
            if (problems.length) {
                e.preventDefault();
                showProblems(problems);
                return;
            }
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.textContent = 'Creating your account…';
        });
        window.addEventListener('pageshow', () => {
            const btn = document.getElementById('submitBtn');
            btn.disabled = false;
            btn.textContent = 'Create account';
        });
    </script>
</body>
</html>
