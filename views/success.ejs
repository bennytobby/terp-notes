<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: (locals.title || 'Done') + ' - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { user: locals.user, hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card tn-status" role="status">
            <div class="tn-status-icon is-ok" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg></div>
            <h1><%= title %></h1>
            <p class="tn-sub"><%= message %></p>
            <div class="tn-actions">
                <a href="<%= locals.link || '/' %>" class="tn-btn tn-btn-primary tn-btn-lg"><%= locals.linkText || 'Continue' %></a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
