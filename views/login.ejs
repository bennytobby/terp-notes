<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Log in - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card">
            <h1>Log in to Terp Notes</h1>
            <p class="tn-sub">Welcome back. Your notes are where you left them.</p>

            <div id="sessionExpiredMessage" class="tn-alert tn-alert-warn" role="status" hidden>
                <span id="expiryMessage">Your session expired. Log in again to continue.</span>
            </div>
            <div id="notificationContainer" aria-live="polite">
                <% if (locals.error) { %><div class="tn-alert tn-alert-error" role="alert"><%= error %></div><% } %>
            </div>

            <form action="/loginSubmit" method="POST" class="tn-form" novalidate>
                <label class="tn-label" for="userid">Username
                    <input class="tn-input" type="text" name="userid" id="userid" autocomplete="username" autocapitalize="none" spellcheck="false" required value="<%= locals.userid || '' %>" />
                </label>
                <label class="tn-label" for="password">
                    <span class="tn-label-row">Password <a href="/forgot-password">Forgot password?</a></span>
                    <input class="tn-input" type="password" name="password" id="password" autocomplete="current-password" required />
                </label>
                <label class="tn-check">
                    <input type="checkbox" name="rememberMe" id="rememberMe" />
                    Keep me logged in for 30 days
                </label>
                <button type="submit" class="tn-btn tn-btn-primary tn-btn-lg tn-btn-block" id="loginBtn">Log in</button>
            </form>
            <p class="tn-alt">New to Terp Notes? <a href="/register">Create an account</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function showNotification(message) {
            const box = document.getElementById('notificationContainer');
            box.innerHTML = '';
            const el = document.createElement('div');
            el.className = 'tn-alert tn-alert-error';
            el.setAttribute('role', 'alert');
            el.textContent = message;
            box.appendChild(el);
        }

        const params = new URLSearchParams(window.location.search);
        if (params.get('session_expired') === 'true') {
            const box = document.getElementById('sessionExpiredMessage');
            if (params.get('message')) document.getElementById('expiryMessage').textContent = params.get('message');
            box.hidden = false;
            window.history.replaceState({}, document.title, '/login');
        }

        document.querySelector('form').addEventListener('submit', function (e) {
            const user = document.getElementById('userid');
            const pass = document.getElementById('password');
            user.classList.toggle('is-invalid', !user.value.trim());
            pass.classList.toggle('is-invalid', !pass.value);
            if (!user.value.trim() || !pass.value) {
                e.preventDefault();
                showNotification('Enter your username and password.');
                (user.value.trim() ? pass : user).focus();
                return;
            }
            const btn = document.getElementById('loginBtn');
            btn.disabled = true;
            btn.textContent = 'Logging in…';
        });
        // Re-enable the button if the browser restores this page from its back/forward cache.
        window.addEventListener('pageshow', () => {
            const btn = document.getElementById('loginBtn');
            btn.disabled = false;
            btn.textContent = 'Log in';
        });
    </script>
</body>
</html>
