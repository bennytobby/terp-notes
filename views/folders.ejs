<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Saved folders - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/topnav', { active: 'folders' }) %>
    <main class="tn-page tn-folders" id="main">
        <header class="tn-page-head">
            <div>
                <h1>Saved folders</h1>
                <p class="tn-sub">Keep links to class notes you want to revisit. Only you can see your folders.</p>
            </div>
        </header>
        <form class="tn-folder-form" data-folder-action="create">
            <div class="tn-field">
                <label for="newFolderName">Folder name</label>
                <input id="newFolderName" name="name" type="text" maxlength="60" required />
            </div>
            <button type="submit" class="tn-btn tn-btn-primary">Create folder</button>
        </form>
        <% if (folders.length) { %>
            <nav class="tn-folder-links" aria-label="Your folders">
                <% for (const folder of folders) { %>
                    <a class="tn-btn tn-btn-outline" href="/folders?folder=<%= folder.id %>" <% if (folder === activeFolder) { %>aria-current="page"<% } %>><%= folder.name %></a>
                <% } %>
            </nav>
        <% } %>
        <% if (activeFolder) { %>
            <section class="tn-folder-section" aria-labelledby="folderTitle">
                <h2 id="folderTitle"><%= activeFolder.name %></h2>
                <% if (activeFolder.notes.length) { %>
                    <ul class="tn-folder-notes">
                        <% for (const id of activeFolder.notes) { const note = byId.get(String(id)); %>
                            <li>
                                <% if (note && !note.s3Missing) { %>
                                    <div class="tn-folder-note">
                                        <a href="/download/<%= encodeURIComponent(note.filename) %>"><%= note.originalName %></a>
                                        <small><%= note.classCode || '' %></small>
                                    </div>
                                    <a class="tn-btn tn-btn-outline" href="/download/<%= encodeURIComponent(note.filename) %>?force=download" aria-label="Download <%= note.originalName %>">Download</a>
                                <% } else { %>
                                    <span class="tn-folder-note">Note unavailable</span>
                                <% } %>
                                <form data-folder-action="remove">
                                    <input type="hidden" name="folderId" value="<%= activeFolder.id %>" />
                                    <input type="hidden" name="noteId" value="<%= id %>" />
                                    <button type="submit" class="tn-btn tn-btn-outline" aria-label="Remove <%= note && !note.s3Missing ? note.originalName : 'unavailable note' %> from folder">Remove</button>
                                </form>
                            </li>
                        <% } %>
                    </ul>
                <% } else { %>
                    <p>This folder is empty. <a href="/dashboard">Browse notes</a> and choose Save to folder from a note’s menu.</p>
                <% } %>
                <details class="tn-folder-manage">
                    <summary>Manage folder</summary>
                    <form class="tn-folder-form" data-folder-action="rename">
                        <input type="hidden" name="folderId" value="<%= activeFolder.id %>" />
                        <div class="tn-field">
                            <label for="renameFolder">New folder name</label>
                            <input id="renameFolder" name="name" type="text" maxlength="60" value="<%= activeFolder.name %>" required />
                        </div>
                        <button type="submit" class="tn-btn tn-btn-outline">Rename folder</button>
                    </form>
                    <form data-folder-action="delete">
                        <input type="hidden" name="folderId" value="<%= activeFolder.id %>" />
                        <button type="submit" class="tn-btn tn-btn-outline tn-danger-text">Delete folder</button>
                    </form>
                </details>
            </section>
        <% } else { %>
            <p>Create a folder to start saving notes.</p>
        <% } %>
    </main>
    <script src="/javascripts/note-folders.js" defer></script>
</body>
</html>
