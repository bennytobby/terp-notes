<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: (locals.title || 'Something went wrong') + ' - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { user: locals.user, hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card tn-status" role="alert">
            <div class="tn-status-icon is-error" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5h.01"/></svg></div>
            <h1><%= locals.title || 'Something went wrong' %></h1>
            <p class="tn-sub" style="white-space: pre-line;"><%= locals.message || 'Please try again in a moment.' %></p>
            <div class="tn-actions">
                <a href="<%= locals.link || '/' %>" class="tn-btn tn-btn-primary tn-btn-lg"><%= locals.linkText || 'Go home' %></a>
                <% if (locals.link !== '/contact') { %>
                    <a href="/contact" class="tn-btn tn-btn-outline tn-btn-lg">Contact support</a>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
