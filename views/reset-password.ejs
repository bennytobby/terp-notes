<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Choose a new password - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card">
            <h1>Choose a new password</h1>
            <p class="tn-sub">Use something you don't use anywhere else.</p>
            <form action="/reset-password/<%= token %>" method="POST" class="tn-form">
                <label class="tn-label" for="password">New password
                    <input class="tn-input" type="password" id="password" name="password" required autofocus autocomplete="new-password" aria-describedby="password-rules" />
                    <ul class="tn-rules" id="password-rules" aria-live="polite">
                        <li id="req-length">8+ characters</li>
                        <li id="req-uppercase">An uppercase letter</li>
                        <li id="req-lowercase">A lowercase letter</li>
                        <li id="req-number">A number</li>
                        <li id="req-special">A symbol (!@#$…)</li>
                    </ul>
                </label>
                <label class="tn-label" for="confirm_password">Confirm new password
                    <input class="tn-input" type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" />
                    <span class="tn-help" id="match-help" aria-live="polite"></span>
                </label>
                <button type="submit" class="tn-btn tn-btn-primary tn-btn-lg tn-btn-block">Save new password</button>
            </form>
            <p class="tn-alt"><a href="/login">Back to log in</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        const rules = {
            length: (p) => p.length >= 8,
            uppercase: (p) => /[A-Z]/.test(p),
            lowercase: (p) => /[a-z]/.test(p),
            number: (p) => /[0-9]/.test(p),
            special: (p) => /[!@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(p),
        };
        const pass = document.getElementById('password');
        const confirmPass = document.getElementById('confirm_password');
        const help = document.getElementById('match-help');
        function update() {
            let ok = true;
            for (const [name, test] of Object.entries(rules)) {
                const met = test(pass.value);
                document.getElementById('req-' + name).classList.toggle('is-met', met);
                ok = ok && met;
            }
            const same = confirmPass.value && confirmPass.value === pass.value;
            help.textContent = !confirmPass.value ? '' : same ? '✓ Passwords match' : "Passwords don't match yet";
            help.style.color = same ? 'var(--tn-ok)' : '';
            return ok && same;
        }
        pass.addEventListener('input', update);
        confirmPass.addEventListener('input', update);
        document.querySelector('form').addEventListener('submit', (e) => {
            if (!update()) {
                e.preventDefault();
                (pass.value && rules.length(pass.value) ? confirmPass : pass).focus();
                help.textContent = help.textContent || 'Meet every item in the checklist, then confirm the password.';
            }
        });
    </script>
</body>
</html>
