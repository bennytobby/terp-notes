<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Log out - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { hideAuth: true }) %>

    <main class="tn-center" id="main">
        <div class="tn-card tn-status">
            <div class="tn-status-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            </div>
            <h1>Log out<%= (locals.user && user.firstname) ? `, ${user.firstname}` : '' %>?</h1>
            <p class="tn-sub">You'll be logged out on this device, in every tab.</p>
            <div class="tn-actions tn-actions-stack">
                <button type="button" onclick="logoutAllTabs()" class="tn-btn tn-btn-primary tn-btn-lg tn-btn-block">Log out</button>
                <a href="/dashboard" class="tn-btn tn-btn-outline tn-btn-lg tn-btn-block">Stay logged in</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function logoutAllTabs() {
            // Other open tabs listen for this flag and log out too.
            try { localStorage.setItem('terpnotes_logout', 'true'); } catch (e) {}
            window.location.href = '/logout?all=true';
        }
    </script>
</body>
</html>
