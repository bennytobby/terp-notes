<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Page not found - Terp Notes' }) %>
</head>
<body class="tn-app">
    <%- include('partials/publicnav', { user: locals.user }) %>

    <main class="tn-center" id="main">
        <div class="tn-card tn-status">
            <p class="tn-fine" style="font-weight: 700; letter-spacing: 0.08em; margin-bottom: 0.75rem;">404</p>
            <h1>Page Not Found</h1>
            <p class="tn-sub">That link is broken or the page moved. The notes are still where you left them.</p>
            <div class="tn-actions">
                <% if (locals.user) { %>
                    <a href="/dashboard" class="tn-btn tn-btn-primary tn-btn-lg">Go to your notes</a>
                <% } else { %>
                    <a href="/" class="tn-btn tn-btn-primary tn-btn-lg">Go home</a>
                <% } %>
                <a href="/contact" class="tn-btn tn-btn-outline tn-btn-lg">Report a broken link</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
