<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Admin - Terp Notes' }) %>
    <link rel="stylesheet" href="/stylesheets/admin.css" />
</head>

<%
  const staffRows = locals.courseStaffList || [];
  const flagged = locals.flaggedFiles || [];
  const reportList = locals.reports || [];
  const annList = locals.announcements || [];
  const reviewCount = flagged.length + reportList.length;
  const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Unknown';
  const fmtDateTime = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
  const initialsOf = (u) => ((u.firstname || '').charAt(0) + (u.lastname || '').charAt(0)).toUpperCase() || (u.userid || '?').charAt(0).toUpperCase();
  const roleLabel = { admin: 'Admin', contributor: 'Contributor', viewer: 'Viewer' };
  const typeLabel = { info: 'Info', warning: 'Warning', success: 'Success' };
%>

<body class="tn-app">
    <%- include('partials/topnav', { active: 'admin' }) %>

    <main class="tn-page adm" id="main">
        <header class="tn-page-head">
            <div>
                <h1>Admin</h1>
                <p class="tn-sub">Review flagged notes, manage people and post announcements.</p>
            </div>
        </header>

        <nav class="adm-jump" aria-label="Admin sections">
            <a href="#review">Needs review<% if (reviewCount) { %> <span class="adm-count adm-count-alert"><%= reviewCount %></span><% } %></a>
            <a href="#users">People <span class="adm-count" data-user-total><%= users.length %></span></a>
            <a href="#course-staff-section">Course staff</a>
            <a href="#announcements">Announcements</a>
            <a href="#tools">Tools</a>
        </nav>

        <div class="adm-stats" role="list" aria-label="Accounts">
            <div class="adm-stat" role="listitem"><strong id="totalUsers"><%= users.length %></strong><span>Users</span></div>
            <div class="adm-stat" role="listitem"><strong id="adminCount"><%= users.filter(u => u.role === 'admin').length %></strong><span>Admins</span></div>
            <div class="adm-stat" role="listitem"><strong id="contributorCount"><%= users.filter(u => u.role === 'contributor').length %></strong><span>Contributors</span></div>
            <div class="adm-stat" role="listitem"><strong id="viewerCount"><%= users.filter(u => u.role === 'viewer').length %></strong><span>Viewers</span></div>
        </div>

        <!-- Needs review: the confidential-info scanner's flags, then student reports. -->
        <section class="adm-section" id="review" aria-labelledby="reviewTitle">
            <div class="adm-section-head">
                <div>
                    <h2 id="reviewTitle">Needs review <span class="adm-count<%= reviewCount ? ' adm-count-alert' : '' %>" data-review-count><%= reviewCount %></span></h2>
                    <p class="tn-sub">High-risk scanner flags are hidden from students until you approve them. Medium ones stay visible.</p>
                </div>
            </div>

            <p class="adm-empty" data-review-empty <%= reviewCount ? 'hidden' : '' %>>Nothing to review. You're all caught up.</p>

            <div class="adm-list" data-review-list>
                <% flagged.forEach(file => { const scan = file.confidentialScan || {}; const high = scan.level === 'high'; %>
                    <article class="adm-item flagged-card" data-file-hash="<%= file.fileHash %>">
                        <div class="adm-item-top">
                            <h3><%= file.originalName %></h3>
                            <div class="adm-badges">
                                <span class="tn-badge <%= high ? 'tn-badge-error' : 'tn-badge-warn' %> flag-level"><%= high ? 'High: hidden' : 'Medium: visible' %></span>
                                <span class="tn-badge">Confidential info</span>
                            </div>
                        </div>
                        <% if ((scan.findings || []).length) { %>
                            <ul class="adm-findings">
                                <% scan.findings.forEach(f => { %>
                                    <li><%= f.label %> (<%= f.count %>)<% if (f.samples && f.samples.length) { %>: <code><%= f.samples.join(', ') %></code><% } %></li>
                                <% }) %>
                            </ul>
                        <% } %>
                        <p class="adm-meta">
                            <span><%= file.classCode %></span>
                            <span>Uploaded by <%= file.uploadedBy %></span>
                            <span><%= fmtDateTime(file.uploadDate) %></span>
                        </p>
                        <div class="adm-actions">
                            <a href="/download/<%= encodeURIComponent(file.filename) %>" class="tn-btn tn-btn-outline tn-btn-sm" target="_blank" rel="noopener noreferrer">Open file</a>
                            <button type="button" class="tn-btn tn-btn-outline tn-btn-sm" data-confidential="approve" data-hash="<%= file.fileHash %>">Approve</button>
                            <button type="button" class="tn-btn tn-btn-danger tn-btn-sm" data-confidential="remove" data-hash="<%= file.fileHash %>">Remove file</button>
                        </div>
                    </article>
                <% }) %>

                <% reportList.forEach(report => { %>
                    <article class="adm-item report-card" data-report-id="<%= report._id %>">
                        <div class="adm-item-top">
                            <h3><%= report.originalName %></h3>
                            <div class="adm-badges"><span class="tn-badge tn-badge-warn">Reported</span></div>
                        </div>
                        <p class="adm-reason"><strong>Reason:</strong> <%= report.reason %><% if (report.details) { %><br><span class="adm-muted"><%= report.details %></span><% } %></p>
                        <p class="adm-meta">
                            <span><%= report.classCode %></span>
                            <span>Reported by <%= report.reportedBy %></span>
                            <span>Uploaded by <%= report.fileUploader %></span>
                            <span><%= fmtDateTime(report.reportedAt) %></span>
                        </p>
                        <div class="adm-actions">
                            <a href="/download/<%= encodeURIComponent(report.filename) %>" class="tn-btn tn-btn-outline tn-btn-sm" target="_blank" rel="noopener noreferrer">Open file</a>
                            <button type="button" class="tn-btn tn-btn-outline tn-btn-sm" data-report="dismiss" data-id="<%= report._id %>">Dismiss</button>
                            <button type="button" class="tn-btn tn-btn-danger tn-btn-sm" data-report="delete" data-id="<%= report._id %>">Delete file</button>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>

        <!-- People -->
        <section class="adm-section" id="users" aria-labelledby="usersTitle">
            <div class="adm-section-head">
                <h2 id="usersTitle">People</h2>
                <div class="adm-filters">
                    <input type="search" id="userSearch" class="tn-input" placeholder="Search people" aria-label="Search people by name, email or ID" autocomplete="off" />
                    <select id="roleFilter" aria-label="Filter by role">
                        <option value="">All roles</option>
                        <option value="admin">Admins</option>
                        <option value="contributor">Contributors</option>
                        <option value="viewer">Viewers</option>
                        <option value="banned">Banned</option>
                    </select>
                </div>
            </div>
            <p class="adm-empty" data-users-empty hidden>No one matches that search.</p>

            <div class="adm-users">
                <% users.forEach(u => { const a = u.analytics || {}; const isMe = user.userid === u.userid; const name = [u.firstname, u.lastname].filter(Boolean).join(' ') || u.userid; %>
                    <article class="adm-user user-card<%= a.isCurrentlyBanned ? ' is-banned' : '' %>" data-user-id="<%= u.userid %>" data-role="<%= u.role %>"
                        data-banned="<%= a.isCurrentlyBanned ? '1' : '' %>"
                        data-search="<%= [name, u.email, u.userid].join(' ').toLowerCase() %>">
                        <div class="adm-user-head">
                            <span class="adm-avatar" aria-hidden="true"><%= initialsOf(u) %></span>
                            <div class="adm-user-id">
                                <h3><%= name %></h3>
                                <p><%= u.email %></p>
                                <p class="adm-muted">@<%= u.userid %> · joined <%= fmtDate(u.createdAt) %></p>
                            </div>
                        </div>
                        <div class="adm-badges">
                            <span class="tn-badge adm-role user-role role-<%= u.role %>"><%= roleLabel[u.role] || u.role %></span>
                            <% if (a.isCurrentlyBanned) { %><span class="tn-badge tn-badge-error">Banned</span><% } %>
                            <% if (u.isProtected) { %><span class="tn-badge">Protected</span><% } %>
                            <% if (isMe) { %><span class="tn-badge adm-you">You</span><% } %>
                        </div>

                        <dl class="adm-user-stats">
                            <div><dt>Uploads</dt><dd><%= a.filesUploaded || 0 %></dd></div>
                            <div><dt>Downloads</dt><dd><%= a.totalDownloads || 0 %></dd></div>
                            <div><dt>Reports</dt><dd title="Reports they made / reports against their files"><%= a.filesReported || 0 %> / <%= a.filesOfUserReported || 0 %></dd></div>
                        </dl>

                        <% if (a.banHistoryCount > 0 && a.lastBanReason) { %>
                            <p class="adm-note adm-note-error">
                                Banned <%= a.banHistoryCount %>×. Last: <%= a.lastBanReason %><% if (a.lastBanDate) { %>, <%= fmtDate(a.lastBanDate) %><% } %><% if (a.lastBanDurationText) { %> (<%= a.lastBanDurationText %>)<% } %>
                            </p>
                        <% } %>
                        <% if (a.latestUpload) { %>
                            <p class="adm-note">Latest upload: <%= a.latestUpload.originalName %> · <%= fmtDate(a.latestUpload.uploadDate) %></p>
                        <% } %>

                        <div class="adm-user-actions">
                            <div class="adm-role-row">
                                <label class="tn-visually-hidden" for="role-<%= u.userid %>">Role for <%= name %></label>
                                <select id="role-<%= u.userid %>" class="role-select" <%= u.isProtected || isMe ? 'disabled' : '' %>>
                                    <% ['admin', 'contributor', 'viewer'].forEach(r => { %>
                                        <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= roleLabel[r] %></option>
                                    <% }) %>
                                </select>
                                <% if (!u.isProtected && !isMe) { %>
                                    <button type="button" class="tn-btn tn-btn-primary tn-btn-sm update-role-btn" data-user-id="<%= u.userid %>" disabled>Save</button>
                                <% } %>
                            </div>
                            <div class="adm-actions">
                                <button type="button" class="tn-btn tn-btn-outline tn-btn-sm history-btn" data-user-id="<%= u.userid %>" data-user-name="<%= name %>">History</button>
                                <% if (!isMe && !u.isProtected) { %>
                                    <% if (a.isCurrentlyBanned) { %>
                                        <button type="button" class="tn-btn tn-btn-outline tn-btn-sm unban-btn" data-user-id="<%= u.userid %>" data-user-name="<%= name %>">Unban</button>
                                    <% } else { %>
                                        <button type="button" class="tn-btn tn-btn-outline tn-btn-sm ban-btn" data-user-id="<%= u.userid %>" data-user-name="<%= name %>">Ban</button>
                                    <% } %>
                                    <button type="button" class="tn-btn tn-btn-sm adm-btn-danger-ghost delete-btn" data-user-id="<%= u.userid %>" data-user-name="<%= name %>">Delete</button>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>

        <!-- Course staff -->
        <section class="adm-section" id="course-staff-section" aria-labelledby="staffTitle">
            <div class="adm-section-head">
                <div>
                    <h2 id="staffTitle">Course staff</h2>
                    <p class="tn-sub">Invite a professor to a course. They can moderate that course's notes and add their own TAs.</p>
                </div>
            </div>
            <form id="professor-invite-form" class="adm-invite" autocomplete="off">
                <input name="email" type="email" class="tn-input" required placeholder="Professor's email" aria-label="Professor's email" />
                <div class="combo">
                    <input name="classCode" id="inviteCourse" class="tn-input" required placeholder="Course, e.g. CMSC131" aria-label="Course code" maxlength="40" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="inviteCourseList" aria-autocomplete="list" />
                    <ul class="combo-list" id="inviteCourseList" role="listbox" aria-label="Matching UMD courses" hidden></ul>
                </div>
                <button type="submit" class="tn-btn tn-btn-primary">Create invite</button>
            </form>
            <div id="invite-result" class="adm-invite-result" hidden></div>

            <p class="adm-empty" data-staff-empty <%= staffRows.length ? 'hidden' : '' %>>No course staff yet.</p>
            <ul class="adm-rows" data-staff-list>
                <% staffRows.forEach(r => { %>
                    <li class="staff-admin-row" data-course="<%= r.classCode %>" data-userid="<%= r.userid %>">
                        <strong><%= r.classCode %></strong>
                        <span><%= r.userid %></span>
                        <span class="tn-badge"><%= r.role === 'professor' ? 'Professor' : 'TA' %></span>
                        <button type="button" class="tn-btn tn-btn-sm adm-btn-danger-ghost" data-remove-staff data-course="<%= r.classCode %>" data-userid="<%= r.userid %>">Remove</button>
                    </li>
                <% }) %>
            </ul>
        </section>

        <!-- Announcements -->
        <section class="adm-section" id="announcements" aria-labelledby="annTitle">
            <div class="adm-section-head">
                <div>
                    <h2 id="annTitle">Announcements</h2>
                    <p class="tn-sub">Shown at the top of everyone's notes page.</p>
                </div>
            </div>

            <form id="announcementForm" class="adm-ann-form">
                <label class="tn-field">
                    <span>New announcement</span>
                    <textarea id="announcementMessage" class="tn-input" required rows="3" maxlength="500" placeholder="e.g. Finals week: share your study guides!"></textarea>
                </label>
                <div class="adm-ann-foot">
                    <fieldset class="adm-seg">
                        <legend class="tn-visually-hidden">Type</legend>
                        <% ['info', 'warning', 'success'].forEach((t, i) => { %>
                            <label><input type="radio" name="announcementType" value="<%= t %>" <%= i === 0 ? 'checked' : '' %>><span><i class="adm-dot adm-dot-<%= t %>" aria-hidden="true"></i><%= typeLabel[t] %></span></label>
                        <% }) %>
                    </fieldset>
                    <button type="submit" id="createAnnouncementBtn" class="tn-btn tn-btn-primary">Post</button>
                </div>
            </form>

            <% if (annList.length) { %>
                <ul class="adm-rows adm-anns">
                    <% annList.forEach(ann => { %>
                        <li class="adm-ann<%= ann.isActive ? '' : ' is-hidden' %>">
                            <i class="adm-dot adm-dot-<%= ann.type %>" aria-hidden="true"></i>
                            <div class="adm-ann-body">
                                <p><%= ann.message %></p>
                                <small><%= typeLabel[ann.type] || ann.type %> · <%= ann.isActive ? 'Showing' : 'Hidden' %> · <%= ann.createdBy %>, <%= fmtDate(ann.createdAt) %></small>
                            </div>
                            <div class="adm-actions">
                                <button type="button" class="tn-btn tn-btn-outline tn-btn-sm" data-ann-edit data-id="<%= ann._id %>" data-message="<%= ann.message %>" data-type="<%= ann.type %>">Edit</button>
                                <button type="button" class="tn-btn tn-btn-outline tn-btn-sm" data-ann-toggle data-id="<%= ann._id %>"><%= ann.isActive ? 'Hide' : 'Show' %></button>
                                <button type="button" class="tn-btn tn-btn-sm adm-btn-danger-ghost" data-ann-delete data-id="<%= ann._id %>">Delete</button>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="adm-empty">No announcements yet.</p>
            <% } %>
        </section>

        <!-- Tools -->
        <section class="adm-section" id="tools" aria-labelledby="toolsTitle">
            <div class="adm-section-head"><h2 id="toolsTitle">Tools</h2></div>
            <div class="adm-tool" id="study-index-section">
                <div>
                    <h3>Study Buddy index</h3>
                    <p class="tn-sub">New uploads are indexed automatically. This indexes notes uploaded before Study Buddy existed and retries ones that couldn't be read, in small batches until everything is done.</p>
                    <p class="adm-status" id="study-index-status" role="status"></p>
                </div>
                <button type="button" class="tn-btn tn-btn-outline" id="study-index-btn">Index older notes</button>
            </div>
        </section>
    </main>

    <!-- Ban -->
    <div class="adm-modal" id="banModal" hidden>
        <div class="adm-dialog" role="dialog" aria-modal="true" aria-labelledby="banTitle">
            <h2 id="banTitle">Ban user</h2>
            <p class="tn-sub" id="banUserInfo"></p>
            <label class="tn-field">
                <span>How long</span>
                <select id="banDuration">
                    <option value="24">1 day</option>
                    <option value="72">3 days</option>
                    <option value="168">1 week</option>
                    <option value="336">2 weeks</option>
                    <option value="720">1 month</option>
                    <option value="2160">3 months</option>
                    <option value="4320">6 months</option>
                    <option value="8760">1 year</option>
                    <option value="permanent">Permanent</option>
                </select>
            </label>
            <label class="tn-field">
                <span>Reason (they'll see this)</span>
                <textarea id="banReason" class="tn-input" rows="3" maxlength="500" placeholder="e.g. Uploaded a current exam"></textarea>
            </label>
            <div class="adm-dialog-foot">
                <button type="button" class="tn-btn tn-btn-outline" data-close>Cancel</button>
                <button type="button" class="tn-btn tn-btn-danger" id="banConfirmBtn">Ban</button>
            </div>
        </div>
    </div>

    <!-- Account history -->
    <div class="adm-modal" id="historyModal" hidden>
        <div class="adm-dialog adm-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="historyModalTitle">
            <div class="adm-dialog-head">
                <h2 id="historyModalTitle">Account history</h2>
                <button type="button" class="tn-icon-btn" data-close aria-label="Close">&times;</button>
            </div>
            <div class="adm-history-filters">
                <select id="historyActionFilter" aria-label="Filter by action">
                    <option value="">All actions</option>
                    <option value="UPLOAD">Uploads</option>
                    <option value="DOWNLOAD">Downloads</option>
                    <option value="REPORT">Reports</option>
                    <option value="BAN">Bans</option>
                    <option value="UNBAN">Unbans</option>
                    <option value="ROLE_CHANGE">Role changes</option>
                    <option value="LOGIN">Sign-ins</option>
                    <option value="LOGOUT">Sign-outs</option>
                </select>
                <select id="historyPageSize" aria-label="Items per page">
                    <option value="25">25 per page</option>
                    <option value="50" selected>50 per page</option>
                    <option value="100">100 per page</option>
                </select>
                <button type="button" id="refreshHistory" class="tn-btn tn-btn-outline tn-btn-sm">Refresh</button>
            </div>
            <div id="historyContent" class="adm-history"></div>
            <div id="historyPagination" class="adm-pager" hidden>
                <span id="historyPaginationInfo"></span>
                <div>
                    <button type="button" id="historyPrevPage" class="tn-btn tn-btn-outline tn-btn-sm">Previous</button>
                    <button type="button" id="historyNextPage" class="tn-btn tn-btn-outline tn-btn-sm">Next</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit announcement -->
    <div class="adm-modal" id="editAnnouncementModal" hidden>
        <form class="adm-dialog" id="editAnnouncementForm" role="dialog" aria-modal="true" aria-labelledby="editAnnTitle">
            <h2 id="editAnnTitle">Edit announcement</h2>
            <label class="tn-field">
                <span>Message</span>
                <textarea id="editAnnouncementMessage" class="tn-input" required rows="4" maxlength="500"></textarea>
            </label>
            <fieldset class="adm-seg">
                <legend class="tn-visually-hidden">Type</legend>
                <% ['info', 'warning', 'success'].forEach(t => { %>
                    <label><input type="radio" name="editAnnouncementType" value="<%= t %>"><span><i class="adm-dot adm-dot-<%= t %>" aria-hidden="true"></i><%= typeLabel[t] %></span></label>
                <% }) %>
            </fieldset>
            <div class="adm-dialog-foot">
                <button type="button" class="tn-btn tn-btn-outline" data-close>Cancel</button>
                <button type="submit" class="tn-btn tn-btn-primary">Save</button>
            </div>
        </form>
    </div>

    <div class="adm-toast" id="admToast" role="status" aria-live="polite" hidden></div>

    <script src="/javascripts/admin.js" defer></script>
    <%- include('partials/footer') %>
    <%- include('partials/custom-alerts') %>
</body>

</html>
